#!/usr/bin/env bash
# Convenience launcher for the Docker stack.
#
#   ./dfae              start the stack (if needed) and open the TUI
#   ./dfae up           start the stack in the background
#   ./dfae ask "..."    run one request and print the answer
#   ./dfae logs [svc]   follow logs (default: dfae)
#   ./dfae status       component health
#   ./dfae down         stop the stack (data is kept)
#   ./dfae reset        stop the stack and DELETE all data and downloaded models
set -euo pipefail
cd "$(dirname "$0")"
compose() { docker compose "$@"; }
# The first start downloads the worker model (~2 GB). Requests fail with "model not found" until that is done.
wait_models() {
  if [[ -n "$(docker compose ps -q --status running ollama-pull 2>/dev/null)" ]]; then
    echo "Waiting for the worker model download to finish (follow it with: ./dfae logs ollama-pull)..." >&2
  fi
  docker compose wait ollama-pull >/dev/null 2>&1 || echo "warning: the worker model download failed; see: ./dfae logs ollama-pull" >&2
}

case "${1:-tui}" in
  up)     compose up -d --build; echo "The worker model may still be downloading on first start: ./dfae logs ollama-pull" >&2 ;;
  # the TUI image is built separately from the server (it is behind a compose profile): rebuild it too, or an
  # old TUI talks to a newer server and cannot read its answers
  tui)    compose up -d --build; compose build tui; wait_models; exec docker compose run --rm tui ;;
  ask)    shift; compose up -d --build dfae >/dev/null; compose build tui >/dev/null; wait_models; exec docker compose run --rm -T tui --ask "$*" ;;
  logs)   shift; exec docker compose logs -f "${1:-dfae}" ;;
  status) compose ps; docker compose exec -T dfae sh -c 'true' 2>/dev/null; curl -fsS "http://127.0.0.1:${DFAE_PORT:-8080}/v1/health" ${DFAE_API_TOKEN:+-H "Authorization: Bearer $DFAE_API_TOKEN"} || true; echo ;;
  down)   compose down ;;
  reset)  read -r -p "This deletes the database, workspace and downloaded models. Continue? [y/N] " a; [[ "$a" == y ]] && compose down -v ;;
  *)      sed -n '2,10p' "$0"; exit 2 ;;
esac
