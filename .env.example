# Copy to .env and edit. Every value is optional.

# --- decision model (open-weight, self-hosted) ----------------------------------
# An instruct model in the `ollama` service answers the engine's typed questions
# (task type, tools needed, risk, mode, tool relevance, recovery…) by single-token
# multiple choice; probabilities are read from its log-probabilities. If it is
# unreachable or not pulled yet, decisions fall back to the built-in rules.
# DECISION_MODEL=qwen3:4b-instruct-2507-q4_K_M # ~2.5 GB (q8_0 is ~4.3 GB: a bit more accurate, slower). Smarter: qwen3:30b-a3b-instruct-2507-q4_K_M
#                                              # (MoE, ~3B active parameters, ~19 GB). Use a NON-thinking model.
# DECISION_PROVIDER=local                      # turn the model off: built-in rules only
# DECISION_BASE_URL=http://ollama:11434/v1     # any OpenAI-compatible server that returns logprobs (vLLM, llama.cpp)
# DECISION_TIMEOUT_MS=15000
# DECISION_KINDS=route_task,select_tools,assess_recovery,assess_escalation,assess_completion   # or: all
#   (the model decides these; mode/plan checks and team splits use the built-in rules — fewer model calls on a CPU)
# DECISION_PARALLEL=3   # questions of one decision asked at once (1 lets the server reuse the cached state between them)

# --- small language model (runs locally in the `ollama` service) ---------------
# SLM_MODEL=qwen2.5:3b          # try qwen2.5:1.5b (faster) or qwen2.5:7b (smarter)

# --- web search (optional) ------------------------------------------------------
# Without these, web_search tries DuckDuckGo's HTML endpoint (best effort: it may
# challenge automated requests) and then Wikipedia. A self-hosted SearXNG instance
# (with the json format enabled) or a Brave Search API key is dependable.
# SEARXNG_URL=http://searxng:8080
# BRAVE_API_KEY=

# --- web search (optional) ------------------------------------------------------
# Without these, web_search tries DuckDuckGo's HTML endpoint (best effort: it may
# challenge automated requests) and then Wikipedia. A self-hosted SearXNG instance
# (json format enabled) or a Brave Search API key is dependable.
# SEARXNG_URL=http://searxng:8080
# BRAVE_API_KEY=

# --- stronger model for escalation (optional) ---------------------------------
# STRONG_PROVIDER=anthropic     # or: openai (any OpenAI-compatible endpoint)
# STRONG_API_KEY=
# STRONG_MODEL=claude-sonnet-5-5
# STRONG_BASE_URL=https://api.anthropic.com

# --- entity extraction --------------------------------------------------------
# GLINER_MODEL=urchade/gliner_small-v2.1

# --- security -----------------------------------------------------------------
# Bearer token required by the HTTP API (the TUI sends it automatically).
DFAE_API_TOKEN=
# Lets requests skip human approvals. For benchmarks/CI only.
# DFAE_ALLOW_AUTO_APPROVE=false

# --- token economy ----------------------------------------------------------------
# DFAE_REPAIR=off                       # disable deterministic repair of arguments / paths
# DFAE_LAZY_CONTEXT=on                  # short upstream summaries + `NEED <step>` expansion (measure first)

# External-model cost (all on by default except the two marked):
# DFAE_PLAN_FORMAT=json                 # plans as JSON instead of compact plan lines
# DFAE_PLAN_PREFIX=narrow               # never send the cacheable tool catalogue (always: send it every time)
# STRONG_PROMPT_CACHE=on                # an OpenAI-compatible external endpoint that caches repeated prompt prefixes
# DFAE_PLAN_REPORT=on                   # (off by default) the planner pre-writes the final reply
# DFAE_ANSWER_LOCAL_FIRST=off           # always ask the external model for the final answer
# DFAE_WORKSPACE_SNAPSHOT=off           # no workspace line in plan prompts
# DFAE_CONDENSE=off                     # no local condensation of big tool outputs
# DFAE_DECISION_LOG=/data/decisions.jsonl   # decisions and their outcomes, for evaluation or fine-tuning
# DFAE_SHADOW_EVAL=0.05                 # (off by default) also ask the external model 5% of the routing questions; spends tokens

# --- teams (automatic subagent delegation) -------------------------------------
# DFAE_TEAM=off                         # disable delegation
# DFAE_MAX_CONCURRENT_TASKS=8           # tasks running at once; more wait in a bounded queue
# DFAE_MAX_AGENTS=8                     # subagents running at once
# DFAE_ROLE_SLOTS=researcher=4,operator=1,analyst=4,verifier=2

# --- misc ---------------------------------------------------------------------
# DFAE_PORT=8080
# POSTGRES_PASSWORD=dfae
