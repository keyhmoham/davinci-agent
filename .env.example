# Copy to .env and edit. Every value is optional.

# --- decision model ---------------------------------------------------------------
# Default: the hosted Decisions API (openai/gpt-6-luna-decisions on Vercel AI Gateway, with PLANNER_API_KEY). Alternatively a self-hosted
# open-weight model, as described below:
# An instruct model in the `ollama` service answers the engine's typed questions
# (task type, tools needed, risk, mode, tool relevance, recovery…) by single-token
# multiple choice; probabilities are read from its log-probabilities. If it is
# unreachable or not pulled yet, decisions fall back to the built-in rules.
DECISION_MODEL=qwen3:4b-instruct-2507-q4_K_M # ~2.5 GB (q8_0 is ~4.3 GB: a bit more accurate, slower). Smarter: qwen3:30b-a3b-instruct-2507-q4_K_M
#                                              # (MoE, ~3B active parameters, ~19 GB). Use a NON-thinking model.
# DECISION_PROVIDER=local                      # turn the model off: built-in rules only (leave this commented out to use the model)
# DECISION_PROVIDER=decisions                  # the hosted Decisions API (openai/gpt-6-luna-decisions on Vercel AI Gateway): the default when
#                                             # DECISION_BASE_URL is unset and PLANNER_API_KEY reaches the gateway (≈ $0.0003/task, measured 98% routing accuracy vs 91% for the rules)
# DECISION_API_MODEL=openai/gpt-6-luna-decisions
# DECISION_BASE_URL=http://ollama:11434/v1   # a self-hosted model instead (start it with COMPOSE_PROFILES=local-decisions): any
#                                             # OpenAI-compatible server that returns logprobs (vLLM, llama.cpp)
DECISION_TIMEOUT_MS=15000
# DECISION_KINDS=route_task,select_tools,assess_recovery,assess_escalation,assess_completion   # or: all
#   (the model decides these; mode/plan checks and team splits use the built-in rules — fewer model calls on a CPU)
DECISION_PARALLEL=3   # questions of one decision asked at once (1 lets the server reuse the cached state between them)

# --- planner model and worker model (hosted) -------------------------------------
# The planner writes and revises plans. The worker carries them out, step by step, together with the decision model, the
# extractor and deterministic rules. Both are configured the same way: PROVIDER is `openai` (any OpenAI-compatible endpoint, the
# default once an API key is set) or `anthropic`; BASE_URL defaults to https://ai-gateway.vercel.sh/v1.
PLANNER_API_KEY=
PLANNER_MODEL=gpt-6-luna
PLANNER_PROVIDER=openai
PLANNER_BASE_URL=https://ai-gateway.vercel.sh/v1
PLANNER_MAX_TOKENS=4096           # output limit of a plan (reasoning models also spend it thinking)
PLANNER_TIMEOUT_SECS=180
PLANNER_REASONING=low             # thinking effort of the planner: off | low | medium | high (a plan is short: low is enough)
PLANNER_PROMPT_CACHE=on           # an OpenAI-compatible endpoint that caches repeated prompt prefixes (Anthropic and api.openai.com do)
WORKER_API_KEY=                   # empty: the planner's key is used when both share a base URL
WORKER_MODEL=glm-5.3-flash
WORKER_PROVIDER=openai
WORKER_BASE_URL=https://ai-gateway.vercel.sh/v1
WORKER_MAX_TOKENS=800             # ordinary work (choosing arguments, short reasoning, answers) is billed: kept short
WORKER_CONTENT_MAX_TOKENS=16000   # writing a file's content (a page, code, data) may run long
WORKER_TIMEOUT_SECS=90
WORKER_REASONING=low              # GLM-5.3-Flash always thinks (off is not possible): low is its least effort (measured: 0 reasoning tokens on ordinary steps)
WORKER_PROVIDERS=baseten,nebius,fireworks   # gateway providers that may serve the worker: unquantised, zero data retention (any: let the gateway choose)

# --- web search (optional) ------------------------------------------------------
# Without these, web_search tries DuckDuckGo's HTML endpoint (best effort: it may
# challenge automated requests) and then Wikipedia. A self-hosted SearXNG instance
# (with the json format enabled) or a Brave Search API key is dependable.
# SEARXNG_URL=http://searxng:8080
# BRAVE_API_KEY=

# --- MCP servers (optional) ---------------------------------------------------------
# With a Glama API key (https://glama.ai/settings/api-keys) the agent finds, connects and uses MCP servers from the Glama directory
# by itself: when a request is about an outside service (GitHub, Notion, a database, …) and no connected server fits, it searches the
# directory with a few words describing the need, connects the best server that works without a login, and its tools join the plan.
# Servers that need OAuth are skipped; one that wants an API key is used when DFAE_MCP_KEY_<SLUG> is set (the slug is the server's
# name in the directory). Servers found in the directory ask for approval (DFAE_APPROVALS=ask) before any tool that is not read-only.
GLAMA_API_KEY=
DFAE_MCP_AUTO=on                       # off: only the servers you configure below
DFAE_MCP_MAX_AUTO=2                    # servers added from the directory for one request
DFAE_MCP_TIMEOUT_SECS=60               # one MCP tool call
# DFAE_MCP_STATE=~/.local/share/dfae/mcp.json   # servers found earlier are reopened at start (outside the workspace on purpose)
# DFAE_MCP_KEY_SENTRY=                   # an API key for a directory server that wants one
# Your own servers, in the usual {"mcpServers": {"name": {"command": "npx", "args": [...], "env": {...}} | {"url": "...", "headers": {...}}}}
# shape; ${VAR} in a value is read from the environment. Only this file can start a local command.
# DFAE_MCP_SERVERS=/etc/dfae/mcp.json

# --- entity extraction --------------------------------------------------------
GLINER_MODEL=urchade/gliner_small-v2.1

# --- security -----------------------------------------------------------------
# Bearer token required by the HTTP API (the TUI sends it automatically).
DFAE_API_TOKEN=
# Lets requests skip human approvals. For benchmarks/CI only.
# DFAE_ALLOW_AUTO_APPROVE=false

# --- token economy ----------------------------------------------------------------
# DFAE_REPAIR=off                       # disable deterministic repair of arguments / paths
# DFAE_LAZY_CONTEXT=on                  # short upstream summaries + `NEED <step>` expansion (measure first)

# External-model cost (all on by default except the two marked):
# DFAE_PLAN_FALLBACK=worker                # let the worker model plan when the planner is unreachable (default: the task fails with the reason)
# DFAE_PLAN_PREFIX=narrow               # never send the cacheable tool catalogue (always: send it every time)
# DFAE_PLAN_REPORT=on                   # (off by default) the planner pre-writes the final reply
# DFAE_ANSWER_LOCAL_FIRST=off           # always ask the external model for the final answer
# DFAE_WORKSPACE_SNAPSHOT=off           # no workspace line in plan prompts
# DFAE_CONDENSE=off                     # no local condensation of big tool outputs
# DFAE_DECISION_LOG=/data/decisions.jsonl   # decisions and their outcomes, for evaluation or fine-tuning
# DFAE_SHADOW_EVAL=0.05                 # (off by default) also ask the external model 5% of the routing questions; spends tokens

# --- agent budget -----------------------------------------------------------------
# Build-and-fix loops (build fails, read the error, fix, build again) need room: each round is one re-plan.
DFAE_MAX_REPLANS=4
# DFAE_MAX_STEPS=30                     # steps of one plan
# DFAE_MAX_MODEL_CALLS=12               # planner-model calls of one task
# DFAE_MAX_WORKER_CALLS=200             # worker-model calls of one task
# DFAE_MAX_TOOL_CALLS=25                # tool calls of one task
# DFAE_MAX_SECONDS=600                  # wall-clock limit of one task
# DFAE_APPROVALS=never                  # ask: risky calls (and non-read-only tools of directory MCP servers) wait for a human

# --- shell sandbox ----------------------------------------------------------------
# NODE_VERSION=lts                      # build argument of the image: the newest Node.js LTS (or an exact one, e.g. v24.22.3)
# The container image ships config/policy.toml with `shell.mode = "sandbox"`: the agent has a full bash and may install what a task needs
# (pip, npm -g, cargo, go, `dfae-apt <package>`) into {workspace}/.tools. Outside the container the default is the read-only allowlist.
# DFAE_POLICY=/etc/dfae/policy.toml
# DFAE_WORKSPACE=/workspace

# --- teams (automatic subagent delegation) -------------------------------------
# DFAE_TEAM=off                         # disable delegation
# DFAE_MAX_CONCURRENT_TASKS=8           # tasks running at once; more wait in a bounded queue
# DFAE_MAX_AGENTS=8                     # subagents running at once
# DFAE_ROLE_SLOTS=researcher=4,operator=1,analyst=4,verifier=2

# --- misc ---------------------------------------------------------------------
# DFAE_PORT=8080
# POSTGRES_PASSWORD=dfae

# --- memory embeddings --------------------------------------------------------------
# Every memory item has a hash embedding (free, offline). It also gets a semantic one from a hosted model, so a paraphrase finds it
# (measured: recall@1 0.65 → 1.00). Default: voyage/voyage-4-lite through Vercel AI Gateway with PLANNER_API_KEY. `hash` turns it off.
# DFAE_EMBEDDINGS=voyage/voyage-4-lite
# DFAE_EMBEDDINGS_DIM=1024                 # needed only for a model the engine does not know
# DFAE_FACTS=off                           # do not extract durable facts from verified tasks into memory
# GLINER_URL=http://gliner:8000            # the optional GLiNER extractor (COMPOSE_PROFILES=gliner)
# DFAE_STEP_AGENT=off                     # a failed step goes straight to the planner (default: the worker first tries to fix it with tools)
