# Copy to .env and edit. Only PLANNER_API_KEY is needed: every other value below is the default, shown so it can be changed.
# Uncommented lines are the defaults the engine uses when the line is left out; commented lines are options.

# --- models: planner and worker (Vercel AI Gateway) --------------------------------
# The planner writes and revises plans; the worker carries them out step by step, with the decision model and deterministic rules.
# PROVIDER is `openai` (any OpenAI-compatible endpoint) or `anthropic`; BASE_URL defaults to the gateway.
PLANNER_API_KEY=
PLANNER_MODEL=gpt-6-luna
PLANNER_PROVIDER=openai
PLANNER_BASE_URL=https://ai-gateway.vercel.sh/v1
PLANNER_MAX_TOKENS=4096           # output limit of a plan (reasoning models also spend it thinking)
PLANNER_TIMEOUT_SECS=180
PLANNER_REASONING=low             # thinking effort for every plan: off | low | medium | high (measured: low passes 19/20)
PLANNER_REASONING_HARD=medium     # from the second re-plan on (a plan that keeps failing is debugging)
# PLANNER_REASONING_ADAPTIVE=on    # effort from the request's complexity instead (measured worse: 14/20 vs 19/20; off by default)
# PLANNER_PROMPT_CACHE=off         # the stable plan prefix is cached (default on for the gateway and api.openai.com; on: another server caches)
# PLANNER_CACHE_TTL_SECS=1500      # how long a cached prefix is assumed warm (default per model: 25 min for OpenAI planners)
WORKER_API_KEY=                   # empty: the planner's key is used when both share a base URL
WORKER_MODEL=glm-5.3-flash
WORKER_PROVIDER=openai
WORKER_BASE_URL=https://ai-gateway.vercel.sh/v1
WORKER_MAX_TOKENS=800             # ordinary work (choosing arguments, short reasoning, answers) is billed: kept short
WORKER_CONTENT_MAX_TOKENS=16000   # writing a file's content (a page, code, data) may run long
WORKER_TIMEOUT_SECS=90
WORKER_REASONING=low              # GLM-5.3-Flash always thinks: low is its least effort (measured: 0 reasoning tokens on ordinary steps)
WORKER_PROVIDERS=baseten,nebius,fireworks   # gateway providers allowed to serve the worker: unquantised, zero data retention (any: the gateway chooses)

# --- decision model -----------------------------------------------------------------
# Default: the hosted Decisions API, openai/gpt-6-luna-decisions on Vercel AI Gateway, with PLANNER_API_KEY (≈ $0.0003 per task;
# measured 98% routing accuracy vs 91% for the built-in rules). Used whenever PLANNER_API_KEY reaches the gateway and DECISION_BASE_URL
# is unset. If it is unreachable, decisions fall back to the built-in rules.
DECISION_PROVIDER=decisions
DECISION_API_MODEL=openai/gpt-6-luna-decisions
# DECISION_API_BASE_URL=https://ai-gateway.vercel.sh/v1
# DECISION_API_KEY=                     # empty: PLANNER_API_KEY
DECISION_API_TIMEOUT_MS=10000
# DECISION_KINDS=all                    # or a list the model decides (route_task,select_tools,assess_recovery,…); the rest use the rules
#
# Alternatives:
# DECISION_PROVIDER=local               # built-in rules only (no model)
# A self-hosted open-weight model that returns log-probabilities (Ollama, vLLM, llama.cpp): start it with
# COMPOSE_PROFILES=local-decisions and set
# DECISION_PROVIDER=
# DECISION_BASE_URL=http://ollama:11434/v1
# DECISION_MODEL=qwen3:4b-instruct-2507-q4_K_M   # ~2.5 GB; a NON-thinking model. Smarter: qwen3:30b-a3b-instruct-2507-q4_K_M (~19 GB)
# DECISION_TIMEOUT_MS=15000
# DECISION_PARALLEL=3                   # questions of one decision asked at once

# --- memory -------------------------------------------------------------------------
# Every memory has a hash embedding (free, offline) and a semantic one from a hosted model, so a paraphrase finds it
# (measured: recall@1 0.65 → 1.00; with 200 distractors only the semantic one gets the answer to the planner).
DFAE_EMBEDDINGS=voyage/voyage-4-lite    # hash: semantic embeddings off
# DFAE_EMBEDDINGS_DIM=1024              # needed only for a model the engine does not know
# DFAE_EMBEDDINGS_BASE_URL=https://ai-gateway.vercel.sh/v1
# DFAE_EMBEDDINGS_API_KEY=              # empty: PLANNER_API_KEY
DFAE_FACTS=on                           # off: do not extract durable facts from verified tasks into memory
DFAE_REDACT_PII=on                      # off: keep e-mail addresses, phone numbers, card numbers and IBANs in long-term memory
# DFAE_PII_NER_URL=http://gliner-pii:8000   # also redact person names and street addresses (COMPOSE_PROFILES=pii)
# DATABASE_URL=postgres://dfae:dfae@postgres:5432/dfae   # set by compose; unset: memory lives in the process only

# --- step agent -----------------------------------------------------------------------
# A failed step is first fixed by the worker with a short tool loop, before the planner is asked to patch the plan.
DFAE_STEP_AGENT=on                      # off: a failed step goes straight to the planner
DFAE_STEP_AGENT_STYLE=script            # one script per action (CodeAct; measured: fix actions −50%, cost −47%); tools: one tool call per action
DFAE_STEP_AGENT_TURNS=6

# --- outside content (web pages, outside services) -------------------------------------
# Content from outside is extracted from by line number, never summarised in a model's own words. Once a task has read it, changing,
# moving or removing a file that was there before needs the request to name it (or a human), and data read here is not sent out;
# a refused change is planned around. allow: edit freely (e.g. "upgrade the project as the guide at URL says").
DFAE_EXPOSED_CHANGES=guard

# --- MCP servers ------------------------------------------------------------------------
# With a Glama API key (https://glama.ai/settings/api-keys) the agent finds, connects and uses MCP servers from the Glama directory:
# when a request is about an outside service and no connected server fits, it searches the directory, connects the best server that
# works without a login, and its tools join the plan. A remembered server is attached only when the decision model says it fits the
# request. Servers that need OAuth are skipped; one that wants an API key is used when DFAE_MCP_KEY_<SLUG> is set.
GLAMA_API_KEY=
DFAE_MCP_AUTO=on                       # off: only the servers you configure below
DFAE_MCP_MAX_AUTO=2                    # servers added from the directory for one request
DFAE_MCP_TIMEOUT_SECS=60               # one MCP tool call
# DFAE_MCP_STATE=~/.local/share/dfae/mcp.json   # servers found earlier are reopened at start (outside the workspace on purpose)
# DFAE_MCP_KEY_SENTRY=                 # an API key for a directory server that wants one
# Your own servers, in the usual {"mcpServers": {...}} shape; ${VAR} in a value is read from the environment.
# DFAE_MCP_SERVERS=/etc/dfae/mcp.json

# --- web search -------------------------------------------------------------------------
# Without these, web_search tries DuckDuckGo's HTML endpoint (best effort) and then Wikipedia.
# SEARXNG_URL=http://searxng:8080
# BRAVE_API_KEY=

# --- entity extraction (optional) ---------------------------------------------------------
# GLINER_URL=http://gliner:8000          # GLiNER on the hot path (COMPOSE_PROFILES=gliner; measured: no benefit, +18% time)
GLINER_MODEL=urchade/gliner_small-v2.1

# --- security -----------------------------------------------------------------------------
DFAE_API_TOKEN=                         # bearer token required by the HTTP API (the TUI sends it)
DFAE_APPROVALS=never                    # ask: risky calls, and changes held back after outside content was read, wait for a human
# DFAE_ALLOW_AUTO_APPROVE=false         # lets requests skip human approvals (benchmarks/CI only)

# --- token economy (all on by default except where marked) ----------------------------------
# DFAE_REPAIR=off                       # deterministic repair of arguments / paths
# DFAE_CONDENSE=off                     # big tool outputs condensed by line selection (verbatim lines, never a summary)
# DFAE_WORKSPACE_SNAPSHOT=off           # a workspace line in plan prompts
# DFAE_ANSWER_LOCAL_FIRST=off           # always ask the external model for the final answer
# DFAE_PLAN_PREFIX=narrow               # never send the cacheable tool catalogue (always: send it every time)
# DFAE_PLAN_FALLBACK=worker             # (off) let the worker plan when the planner is unreachable
# DFAE_PLAN_REPORT=on                   # (off) the planner pre-writes the final reply
# DFAE_LAZY_CONTEXT=on                  # (off) short upstream summaries + `NEED <step>` expansion
# DFAE_DECISION_LOG=/data/decisions.jsonl   # (off) decisions and their outcomes, for evaluation
# DFAE_SHADOW_EVAL=0.05                 # (off) also ask the external model 5% of the routing questions

# --- agent budget -------------------------------------------------------------------------
DFAE_MAX_REPLANS=4                      # build-and-fix loops need room: each round is one re-plan
# DFAE_MAX_STEPS=30
# DFAE_MAX_MODEL_CALLS=12               # planner-model calls of one task
# DFAE_MAX_WORKER_CALLS=200
# DFAE_MAX_TOOL_CALLS=25
# DFAE_MAX_SECONDS=600

# --- shell sandbox ------------------------------------------------------------------------
# The image ships config/policy.toml with shell.mode = "sandbox": a full bash; what a task installs goes to {workspace}/.tools.
# NODE_VERSION=lts                      # build argument of the image
# DFAE_POLICY=/etc/dfae/policy.toml
# DFAE_WORKSPACE=/workspace

# --- teams (automatic subagent delegation) -----------------------------------------------
# DFAE_TEAM=off
# DFAE_MAX_CONCURRENT_TASKS=8
# DFAE_MAX_AGENTS=8
# DFAE_ROLE_SLOTS=researcher=4,operator=1,analyst=4,verifier=2

# --- misc ---------------------------------------------------------------------------------
# DFAE_PORT=8080
# POSTGRES_PASSWORD=dfae
